COMPOSE_FILE='caddy.yml,euro-office.yml'
COMPOSE_PATH_SEPARATOR=','

# system settings
TIME_ZONE='Europe/Zurich'

# euro office server url
SERVER_HOSTNAME=
SERVER_PROTOCOL='https'
EUROOFFICE_PORT=443

# shared secret for secure communication
EUROOFFICE_JWT_ENABLED=true
EUROOFFICE_JWT_SECRET=<any shared secret>
